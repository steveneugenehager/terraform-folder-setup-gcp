# Copy to terraform.tfvars (gitignored) and fill in.
org_id                    = "123456789012"
terraform_service_account = "terraform@SEED_PROJECT_ID.iam.gserviceaccount.com"

# Optional: defaults shown.
# folder_prefix = "fldr"
